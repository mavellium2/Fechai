// Prisma schema — fechai: SaaS de agente de WhatsApp com IA (MVP)
// Regra multi-tenant: TODA query filtra por tenantId (ver src/lib/prisma + repositórios).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // O engine precisa bater com o OpenSSL de onde o app RODA, não de onde foi
  // gerado. A imagem de produção tem OpenSSL 3 (bookworm); sem declarar, um
  // estágio de build sem a libssl gera só o 1.1.x e toda consulta falha.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum UserRole {
  OWNER // dono do tenant (usuário comum do SaaS)
  SUPERADMIN // admin do painel (admin)/
}

enum PlanKey {
  FREE
  STARTER
  PRO
  BUSINESS
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  planKey   PlanKey  @default(FREE)
  status    String   @default("active") // active | suspended
  createdAt DateTime @default(now())

  // Cota de mensagens/mês: null = usa o teto do plano (`messagesPerMonth`).
  // Preenchido pelo superadmin em /admin/contas para dar um teto diferente do
  // plano — usado pelo enforcement (runAgentTurn) e pelos indicadores de uso.
  // (Era `conversationLimitOverride`, quando a cota contava conversas; virou
  // mensagem porque é a resposta da IA que consome LLM, não a conversa.)
  messageLimitOverride Int?

  // Preço realmente cobrado desta conta, em centavos. null = usa o preço de
  // tabela do plano (`Plan.priceCents`). Preenchido pelo superadmin em
  // /admin/contas quando o valor foi negociado (desconto, cortesia, contrato
  // antigo). Só muda o "Investido" da visão Financeira de /relatorios — cota,
  // limite de agentes e ações continuam vindo do plano, como antes.
  priceCentsOverride Int?

  // Donos e sócios da clínica: quem decide a mensalidade. O decisor do
  // relatório mensal de ROI só pode sair desta lista
  // (`modules/reports/monthly-decision-maker.ts`). Não é `User.role = OWNER`:
  // esse é o login da conta, que costuma ser o da recepção. Mantida pela
  // Mavellium na revisão do relatório; vazia = nenhum relatório fecha.
  ownerNames String[] @default([])

  // Fim do período de teste do plano grátis. O FREE é um trial por tempo: a
  // conta responde até `messagesPerMonth` do plano E até esta data — o que
  // vier primeiro. Passou da data, a IA cala e só volta assinando um plano
  // (o painel continua acessível). Nasce em +`trialDays` na criação da conta
  // (ver provision.ts); o superadmin estende/encerra em /admin/contas.
  // null num tenant FREE = trial já encerrado.
  trialEndsAt DateTime?

  // Onboarding guiado (/onboarding). Enquanto `onboardingCompleted` for false, o
  // dashboard redireciona para o wizard; `onboardingStep` + `onboardingDraft`
  // permitem retomar de onde o usuário parou.
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(1)
  onboardingDraft     Json?

  // Personalização do widget de chat instalado no site do cliente. Cada tenant
  // tem seu próprio widget.js publicado na CDN (ver src/lib/widget/deploy.ts),
  // gerado automaticamente — sem comando manual. `widgetDeployedAt` marca se
  // esse arquivo já existe; null = ainda não foi publicado nenhuma vez.
  // `widgetEnabled` nasce falso: o botão só aparece no site depois de ativado
  // na tela de Integrações (setWidgetEnabled).
  widgetEnabled     Boolean   @default(false)
  widgetColor       String    @default("#6d5ef8")
  widgetGreeting    String    @default("Olá! Como posso ajudar?")
  widgetIconType    String    @default("emoji") // "emoji" | "image"
  widgetIconEmoji   String    @default("💬")
  widgetIconUrl     String? // usado quando widgetIconType == "image" (upload via Bunny)
  widgetShape       String    @default("circle") // "circle" | "rounded" | "square"
  widgetBorderColor String? // null = sem borda
  widgetDeployedAt  DateTime?

  // WhatsApp: se verdadeiro (padrão), o agente ignora mensagens de grupos.
  whatsappIgnoreGroups Boolean @default(true)

  // Liberação comercial/operacional da API oficial da Meta. Nasce desligada:
  // somente o superadmin pode expor essa alternativa para a conta. A Evolution
  // continua sendo o provedor disponível por padrão.
  metaWhatsappEnabled Boolean @default(false)

  // Último alerta de conexão de WhatsApp quebrada enviado para esta conta
  // (ver modules/whatsapp/health.ts). Serve só de cooldown: sem ele, uma conta
  // com o número fora do ar receberia um e-mail a cada varredura do worker até
  // alguém reconectar — o caminho mais curto para o aviso virar spam e ser
  // ignorado justamente quando importa. Null = nunca alertada.
  whatsappHealthAlertAt DateTime?

  // Qualificação do lead (a empresa que assina o fechai), capturada no
  // /cadastro a partir desta reformulação — contas criadas antes ficam null,
  // não é retroativo. O fechai aceita apenas empresas: o documento é CNPJ e
  // mora no User (quem preencheu o formulário); o endereço do negócio é aqui.
  //
  // O endereço vem do CEP (ViaCEP, ver lib/br-address.ts), mas todo campo é
  // editável e guardado como veio da tela — o serviço é conveniência, não
  // fonte da verdade, e CEP de cidade inteira não traz logradouro.
  zipCode              String? // CEP, só dígitos (8) — sem máscara, como os telefones
  street               String? // logradouro ("Avenida Paulista")
  addressNumber        String? // número; String porque "s/n" e "1000-A" existem
  complement           String? // complemento ("sala 42") — opcional no formulário
  neighborhood         String? // bairro
  city                 String? // cidade do negócio
  state                String? // UF (2 letras)
  businessSegment      String? // ex: "estetica", "advocacia", "imobiliaria" — ver BUSINESS_SEGMENTS
  /// Texto livre quando `businessSegment` é "outro" — null nas demais opções.
  /// "Outro" sozinho não qualifica ninguém; é este campo que diz qual.
  businessSegmentOther String?
  referralSource       String? // como conheceu o fechai — ver REFERRAL_SOURCES
  /// Texto livre quando `referralSource` é "outro" — mesma regra do segmento.
  referralSourceOther  String?

  users            User[]
  agents           Agent[]
  knowledgeDocs    KnowledgeDocument[]
  actions          TenantAction[]
  /// Uma conexão por provedor (QR/Evolution e Meta). Ver `WhatsappInstance`.
  whatsappInstances WhatsappInstance[]
  whatsappBlocked  WhatsappBlockedNumber[]
  leads            Lead[]
  conversations    Conversation[]
  feedbacks        Feedback[]
  appointments     Appointment[]
  calendar         CalendarIntegration?
  bitrix           BitrixIntegration?
  bitrixSyncJobs   BitrixSyncJob[]
  clinicorp        ClinicorpIntegration?
  clinicorpReminders ClinicorpReminder[]
  reminderDispatches ReminderDispatch[]
  reminderReceipts ReminderReceipt[]
  calendarFeatures CalendarFeatures?
  leadValues       TenantLeadValue[]
  attendanceCosts  TenantAttendanceCost[]
  referral         Referral?
  auditLogs        AuditLog[]
  broadcasts       BroadcastCampaign[]
  broadcastReceipts BroadcastReceipt[]
  monthlyRoiReports MonthlyRoiReport[]
  monthlyRoiAiChats MonthlyRoiAiChat[]
  monthlyRoiPendencies MonthlyRoiPendency[]
  reportEvents      ReportEvent[]
  knowledgeGaps     KnowledgeGap[]
  knowledgeGapSettings KnowledgeGapSettings?
  serviceArea       TenantServiceArea?
  conversationInsights ConversationInsight[]
  reportTrackingStartedAt DateTime @default(now())
  /// Desde quando a conexão do WhatsApp é monitorada com registro de queda
  /// (`WhatsappIncident`). Gravado pelo monitor de saúde na primeira varredura;
  /// null = nunca medido. O relatório mensal só mostra a disponibilidade do
  /// período coberto: sem medição é "não medido", jamais 100% presumido.
  uptimeTrackedSince DateTime?
  whatsappIncidents WhatsappIncident[]
}

/// Pergunta que o agente não soube responder (P-87), agrupada por semelhança.
/// Uma linha é um ASSUNTO; quem perguntou mora em `KnowledgeGapOccurrence`.
/// Aprovar a resposta cria um documento na base do agente (`documentId`), e é
/// isso que faz o agente passar a responder sozinho. Ver
/// `src/modules/knowledge-gaps/README.md`.
model KnowledgeGap {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// A base é por agente, então o grupo também. `SetNull`: apagar o agente não
  /// apaga a pergunta — a aprovação cai no agente principal.
  agentId         String?
  agent           Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  /// Como o agente registrou a primeira ocorrência: curta e sem dado pessoal.
  question        String
  /// Chave de agrupamento quando não há embeddings (minúsculas, sem acento).
  normalized      String
  /// Vetor da pergunta, para agrupar paráfrases. Gravado via SQL cru, como
  /// `KnowledgeChunk.embedding`. Null = embeddings indisponíveis.
  embedding       Unsupported("vector(1536)")?
  status          String    @default("open") // open | answered | dismissed
  /// Quantas conversas diferentes perguntaram — a "contagem de repetições".
  askedCount      Int       @default(1)
  firstAskedAt    DateTime  @default(now())
  lastAskedAt     DateTime  @default(now())
  draftAnswer     String?
  answer          String?
  /// PRIMEIRA aprovação. Editar a resposta depois não mexe aqui: é a base do
  /// "tempo médio para a equipe responder" do relatório mensal.
  answeredAt      DateTime?
  answerUpdatedAt DateTime?
  answeredById    String?
  answeredByLabel String?
  answeredByRole  String? // clinic | mavellium
  /// Documento criado na base pela aprovação. Sem FK de propósito: o dono pode
  /// apagá-lo em /agentes, e aprovar de novo recria.
  documentId      String?
  dismissedAt     DateTime?
  /// Aviso imediato já enviado (ou dispensado). Claim do worker.
  notifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  occurrences KnowledgeGapOccurrence[]

  @@index([tenantId, status, lastAskedAt])
  @@index([tenantId, answeredAt])
  @@index([status, notifiedAt])
}

/// Uma conversa que fez a pergunta. Única por grupo + conversa: o mesmo contato
/// perguntando duas vezes não conta como duas pessoas.
model KnowledgeGapOccurrence {
  id             String       @id @default(cuid())
  tenantId       String
  gapId          String
  gap            KnowledgeGap @relation(fields: [gapId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Mensagem do contato que levou ao registro — ponta do trecho exibido.
  messageId      String?
  question       String
  askedAt        DateTime     @default(now())
  /// Retomar o contato com a resposta aprovada. Nunca reenviado sozinho:
  /// sending | sent | failed | skipped.
  resumeStatus   String?
  resumeNote     String?
  resumedAt      DateTime?

  @@unique([gapId, conversationId])
  @@index([tenantId])
  @@index([conversationId])
}

/// Regra e avisos da fila, por conta. Sem linha = padrões de
/// `knowledge-gaps/settings.ts`. `responders` só o superadmin altera.
model KnowledgeGapSettings {
  tenantId       String   @id
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  onUnanswered   String   @default("keep") // keep | handoff
  notifyEmail    Boolean  @default(true)
  notifyWhatsapp Boolean  @default(false)
  groupId        String?
  groupName      String?
  immediate      Boolean  @default(true)
  dailyDigest    Boolean  @default(true)
  digestHour     Int      @default(8)
  timezone       String   @default("America/Sao_Paulo")
  responders     String   @default("clinic") // clinic | mavellium | both
  lastDigestAt   DateTime?
  updatedAt      DateTime @updatedAt
}

/// Área de atendimento da clínica: a cidade-base e as outras cidades que ela
/// atende, por NOME. Sem linha = não configurado, e "dentro/fora do raio" fica
/// desconhecido — nunca chutado. Ver `src/modules/lead-insights/README.md`.
model TenantServiceArea {
  tenantId  String   @id
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseCity  String
  /// Outras cidades atendidas (a base entra sempre). Nomes como a clínica digitou.
  cities    String[] @default([])
  updatedAt DateTime @updatedAt
}

/// O que o agente registrou da conversa (tool `record_lead_insight`): cidade,
/// procedimento, primeira dúvida real e motivo de perda. Uma linha por conversa,
/// só com o que o contato DISSE — nunca inferido. "Dentro/fora do raio" e o
/// resultado (agendou, transbordou, perdeu) NÃO são gravados: são calculados na
/// leitura, com a área e os dados de hoje. Chaves de categoria são String (o
/// conjunto cresce com o que a equipe aprovar), não enum.
model ConversationInsight {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId    String       @unique
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Cidade como o contato disse (limpa, para exibição) e a chave normalizada
  /// (minúsculas, sem acento, sem UF) usada para comparar com a área.
  city              String?
  cityKey           String?
  procedure         String?
  /// A PRIMEIRA dúvida real, depois da mensagem padrão do anúncio. Gravada uma
  /// vez: as seguintes não sobrescrevem.
  firstQuestionKey  String?
  firstQuestionText String?
  /// Último motivo de perda registrado pelo agente (o contato pode mudar de ideia).
  lossReasonKey     String?
  lossReasonText    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, cityKey])
}

/// Premissas e texto revisados pela Mavellium, por competência. O fechamento
/// congela os dados usados no PDF; alterar outro mês não reescreve o passado.
model MonthlyRoiReport {
  id           String @id @default(cuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month        String // YYYY-MM, no fuso declarado nas premissas
  assumptions  Json
  adjustments  String @default("")
  nextMonth    String @default("")
  /// Dono ou sócio que decide a mensalidade: recebe o relatório e a reunião.
  /// Fechar exige que esteja em `Tenant.ownerNames`.
  decisionMaker String @default("")
  /// Quem opera o painel na clínica (recepção): recebe cópia, nunca é o decisor.
  operationalContact String @default("")
  /// Caso real do mês, escrito pela Mavellium só com o perfil genérico
  /// ("paciente de 74 anos"). Nome, telefone e e-mail são recusados ao salvar.
  featuredCase String @default("")
  /// "Resumo do período" da página 1 do PDF (o nome da coluna é anterior).
  /// Rascunho pode vir da IA, a partir só de agregados; a Mavellium confere e salva.
  highlights   String @default("")
  /// Próximas ações da página 1: até 3 `{ action, owner, indicator }`
  /// (`monthly-next-actions.ts`). Substitui `nextMonth`, que fica para os
  /// relatórios antigos.
  nextActions  Json   @default("[]")
  /// Explicação das limitações do fechamento. A LISTA das limitações não mora
  /// aqui: é calculada (`monthly-limitations.ts`) e congelada no snapshot.
  limitationsNote String @default("")
  /// Ações combinadas no relatório do mês anterior, avaliadas neste:
  /// `{ action, owner, indicator, status, result }` (`monthly-previous-actions.ts`).
  /// As ações vêm do snapshot anterior; aqui ficam o status e o número que comprova.
  previousActions Json @default("[]")
  /// Fatos medidos do caso do mês (`monthly-case.ts`): idade informada, duração
  /// de cada áudio, dia da semana e período. Nunca nome, telefone ou data exata.
  caseFacts    Json?
  /// Papel do decisor: `owner` (dono) | `partner` (sócio). O decisor nunca é a
  /// recepção, que entra em `operationalContact` e recebe cópia.
  decisionMakerRole  String @default("")
  /// Mudanças no agente no mês: até 8 `{ kind, text, date }`
  /// (`monthly-agent-changes.ts`). `adjustments` fica para os relatórios antigos.
  agentChanges Json   @default("[]")
  status       String @default("draft") // draft | ready
  snapshot     Json?
  /// Quantas vezes foi fechado. Reabrir e fechar de novo não apaga o que foi
  /// entregue: cada fechamento fica em `MonthlyRoiReportVersion`.
  version      Int    @default(0)
  versions     MonthlyRoiReportVersion[]
  preparedBy   String?
  finalizedAt  DateTime?
  sentAt       DateTime?
  meetingAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, month])
  @@index([month, status])
}

/// Cada fechamento de uma competência, com o snapshot entregue e o hash do
/// conteúdo. Só cresce: reabrir a revisão não apaga a versão anterior.
model MonthlyRoiReportVersion {
  id          String   @id @default(cuid())
  reportId    String
  report      MonthlyRoiReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tenantId    String
  version     Int
  snapshot    Json
  contentHash String
  finalizedBy String?
  finalizedAt DateTime @default(now())

  @@unique([reportId, version])
  @@index([tenantId])
}

/// Histórico da conversa "Fazer com I.A" de uma competência. Fica separado de
/// `MonthlyRoiReport` porque a conversa começa antes de a revisão ser salva.
model MonthlyRoiAiChat {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month     String // YYYY-MM
  messages  Json     @default("[]")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, month])
}

/// Acompanhamento da central de pendências de uma competência, por tópico
/// (`modules/reports/monthly-pendencies.ts`). A pendência em si é calculada na
/// leitura; aqui fica só o que a Mavellium registrou. Fica fora de
/// `MonthlyRoiReport` para não mexer no `updatedAt` que protege a revisão.
model MonthlyRoiPendency {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month        String // YYYY-MM
  topic        String // PENDENCY_TOPICS
  assignee     String    @default("") // pessoa da clínica que responde; vazio = a área
  requestedAt  DateTime?
  requestedVia String? // whatsapp | email | copy
  answer       String    @default("")
  answeredAt   DateTime?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, month, topic])
}

/// Eventos explícitos, sem inferir qualificação ou desconhecimento do texto.
model ReportEvent {
  id             String @id @default(cuid())
  tenantId       String
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           String // qualified | handoff | unanswered
  procedure      String?
  dedupKey       String @unique
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt, kind])
}

// Disparos pela Meta: o rascunho revisado vira fila somente por confirmação.
model BroadcastCampaign {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  status          String   @default("draft") // draft | queued | paused | completed | cancelled
  phoneNumberId   String
  template        Json
  createdAt       DateTime @default(now())
  confirmedAt     DateTime?
  confirmedBy     String?  // id do usuário que confirmou; snapshot preservado
  confirmedByLabel String?
  consentVersion  String?
  scheduledAt     DateTime?
  timezone        String   @default("America/Sao_Paulo")
  windowStart     Int      @default(0) // minutos locais; legado = dia inteiro
  windowEnd       Int      @default(1440)
  nextAttemptAt   DateTime @default(now())
  lastProcessedAt DateTime?
  retryCount      Int      @default(0)
  pausedAt        DateTime?
  lastTestAt      DateTime?
  finishedAt      DateTime?
  error           String?
  recipients      BroadcastRecipient[]

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt, tenantId])
}

model BroadcastRecipient {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  row               Int
  phone             String
  name              String?
  parameters        Json
  content           String
  status            String   @default("pending") // pending | sending | sent | failed | unknown | skipped | cancelled
  error             String?
  whatsappMessageId String?  @unique
  attemptedAt       DateTime?
  sentAt            DateTime?
  isTest            Boolean  @default(false)
  deliveryStatus    String?  // sent | delivered | read | failed (retorno Meta)
  deliveredAt       DateTime?
  readAt            DateTime?
  deliveryFailedAt  DateTime?
  deliveryError     String?
  conversationId    String?
  leadStatusAtSend   String?
  repliedAt         DateTime?
  qualifiedAt       DateTime?
  appointmentId     String?
  firstReplyMessageId String? @unique

  @@unique([campaignId, phone, isTest])
  @@index([campaignId, status])
  @@index([status, attemptedAt])
  @@index([phone, sentAt])
}

// Retorno pode chegar antes do commit do envio. Inbox durável e idempotente.
model BroadcastReceipt {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId       String
  phoneNumberId   String
  recipientPhone  String
  status          String
  occurredAt      DateTime
  error           String?
  receivedAt      DateTime @default(now())
  appliedAt       DateTime?
  @@unique([tenantId, messageId, status, occurredAt])
  @@index([tenantId, messageId])
  @@index([appliedAt, receivedAt])
}

model WorkerHeartbeat {
  key             String   @id
  lastSeenAt      DateTime
  lastCompletedAt DateTime?
  error           String?
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(OWNER)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  // Dados de contato de quem preencheu o /cadastro — exigidos no formulário
  // (ver AGENTS.md), mas nulos em contas anteriores (não é retroativo) e em
  // contas criadas pelo admin (/admin/contas), que não passam pelo formulário
  // público. Só dígitos em `document` e nos telefones — a formatação é
  // aplicada na exibição, não no armazenamento.
  document       String? // CNPJ (14 dígitos), sem máscara — só empresas se cadastram
  phone          String? // telefone principal, sem máscara
  phoneSecondary String? // telefone secundário (opcional mesmo no cadastro novo)

  /// Dados pessoais que o /cadastro pedia quando aceitava pessoa física.
  /// O formulário não os coleta mais (só empresas entram, e nem nascimento nem
  /// gênero descrevem um CNPJ), mas as colunas ficam: contas criadas antes têm
  /// valor aqui e apagá-las destruiria histórico para não ganhar nada.
  /// Não voltar a preencher — em conta nova nascem null.
  birthDate DateTime?
  gender    String?

  // Login com Google (NextAuth). Só VINCULA uma conta que já existe — o
  // provider não cria tenant: o /cadastro exige CNPJ, telefone e segmento,
  // dados que o Google não fornece. `googleId` é o `sub` do Google, estável
  // mesmo se a pessoa trocar o e-mail da conta Google.
  googleId       String?   @unique
  googleLinkedAt DateTime?

  passwordResetTokens PasswordResetToken[]

  // Programa de afiliados: presente só se a pessoa optou por ser afiliada
  // (no /cadastro ou ativando depois). Papel, não conta separada.
  affiliate Affiliate?

  /**
   * Usa o produto (agente de WhatsApp), e não só o programa de afiliados.
   * Os dois papéis são independentes e ambos ajustáveis em /configuracoes:
   * "cliente" mora aqui, "afiliado" é a existência de `affiliate`. Quem marca
   * só "afiliado" no /cadastro fica com `false` e vê um painel enxuto — sem
   * agentes, conversas nem aviso de teste grátis, que não valem para quem não
   * usa o agente.
   * Default `true` porque toda conta anterior a este campo é de cliente: o
   * programa de afiliados nasceu depois, e ninguém deve perder o painel numa
   * migração.
   */
  usesProduct Boolean @default(true)

  @@index([tenantId])
}

model Feedback {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message   String
  rating    Int? // 1-5, opcional
  status    String   @default("new") // new | read | resolved
  createdAt DateTime @default(now())

  @@index([tenantId])
}

/// Um agente configurável. Era `AgentConfig` com `tenantId @unique` (um por
/// conta); virou `Agent` (vários por conta, limitado por `maxAgents` do plano).
/// Base de conhecimento e ações passaram a pendurar aqui, não no Tenant: dois
/// agentes da mesma conta atendem contextos diferentes e não podem se
/// contaminar (o de vendas respondendo com documento do suporte).
model Agent {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String    @default("Meu agente")
  systemPrompt    String    @default("")
  objective       String    @default("")
  personaDraft    Json? // respostas cruas do wizard, para reeditar
  /// Definições opcionais das variáveis que o agente extrai durante a conversa.
  variableDefinitions Json?
  /// Agente que atende o número de WhatsApp da conta. Enquanto o WhatsApp for
  /// um por conta (ver CHANGELOG), exatamente um agente é o principal.
  isPrimary       Boolean   @default(false)
  /// Chave geral do agente. `false` = ele para de responder aos CLIENTES
  /// (WhatsApp e widget do site) sem perder persona, base nem ações. Existe
  /// porque a única forma de calar um agente era excluí-lo ou desligar o
  /// WhatsApp inteiro — as duas destrutivas demais para uma pausa.
  ///
  /// O chat de teste ignora a chave (`skipEnabledCheck` em `runAgentTurn`):
  /// desligar é o que se faz para mexer no agente, e um sandbox mudo obrigava
  /// a religar — voltando a atender cliente de verdade — só para conferir.
  enabled         Boolean   @default(true)
  /// Ouve mensagens de voz do WhatsApp: o áudio é transcrito e o agente
  /// responde como se fosse texto. Desligado, áudios são ignorados.
  listenAudio     Boolean   @default(true)
  /// Cliente reage com um emoji ou manda só um emoji: a conversa encerra e o
  /// agente para de responder nela (mesmo mecanismo de quando um humano assume
  /// — `agentPaused`). O dono devolve a conversa em /conversas para retomar.
  stopOnEmoji     Boolean   @default(true)
  /// Responde em áudio, na voz gravada pelo dono da conta (`voiceId`), quando o
  /// cliente mandou áudio — o espelho de `listenAudio`. Nasce DESLIGADO: falar
  /// exige uma voz clonada, e a conta só tem uma depois de gravar em /agentes.
  /// Ligado sem `voiceId`, ou com a Fish Audio fora do ar, a resposta sai em
  /// texto: voz é forma de entrega, nunca condição para o contato ser atendido.
  speakReplies    Boolean   @default(false)
  /// Id do modelo de voz na Fish Audio (`reference_id` do POST /v1/tts), criado
  /// a partir da amostra que o dono gravou. Não é segredo — é um identificador
  /// opaco, inútil sem a chave da plataforma —, por isso fica em claro, ao
  /// contrário das credenciais de terceiros (ver `lib/crypto.ts`).
  voiceId         String?
  /// Nome que o dono deu à voz, só para a tela dizer qual voz está no ar.
  voiceLabel      String?
  /// De onde veio a voz: "recorded" (clonada da gravação do dono) ou "catalog"
  /// (uma das vozes prontas, ver `modules/voice/catalog.ts`). Null nas contas
  /// anteriores a este campo, que só podiam ter voz gravada.
  ///
  /// A distinção importa no DESCARTE: uma voz gravada é um modelo nosso na Fish
  /// Audio e precisa ser apagada lá junto (senão fica a voz de um cliente
  /// órfã na conta da plataforma); uma voz do catálogo é compartilhada e
  /// apagá-la derrubaria a voz de todas as outras contas que a escolheram.
  voiceSource     String?
  /// Quando a voz foi gravada — a tela usa para mostrar "gravada em ...".
  voiceCreatedAt  DateTime?
  /// Como a voz se comporta ao falar: "neutra" (padrão), "calorosa" ou
  /// "animada" — ver `modules/voice/style.ts`, que guarda os números da Fish
  /// por trás de cada uma. Nasce neutra: uma voz que improvisa (e por isso ri
  /// sozinha) é surpresa no meio de um atendimento, então quem quer isso
  /// escolhe. Chave desconhecida ou null cai na neutra na leitura.
  voiceStyle      String    @default("neutra")
  /// Instruções do dono para a redação das respostas automáticas em áudio.
  /// A Fish não recebe prompts; o agente aplica esta instrução ao compor a
  /// resposta para quem mandou áudio, sem alterar mensagens escritas.
  voicePrompt     String    @default("") @db.Text
  /// O que o agente NÃO pronuncia quando a resposta vira áudio — um termo por
  /// linha, no mesmo formato das regras da persona (`personaDraft.avoid`).
  ///
  /// Sai só do texto FALADO: `Message.content` continua sendo o que o agente
  /// escreveu (é ele que vai para o histórico, o resumo e o próximo turno do
  /// LLM). Risada escrita, emoji e formatação já saem por padrão em
  /// `modules/voice/speech-text.ts`; esta lista é para o que é específico do
  /// negócio — um bordão, um apelido, uma muleta que o LLM repete.
  ///
  /// Coluna no `Agent`, e não `TenantAction.config`: voz não é uma ação do
  /// catálogo, é comportamento do agente — mesmo lugar de `speakReplies` e
  /// `voiceId`.
  speechBlocklist String    @default("")
  archived        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  knowledgeDocs KnowledgeDocument[]
  knowledgeGaps KnowledgeGap[]
  actions       TenantAction[]
  conversations Conversation[]
  appointments  Appointment[]

  @@index([tenantId])
}

model KnowledgeDocument {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Documento pertence a UM agente. `tenantId` segue aqui porque a regra de
  // ouro do multi-tenant é toda query filtrar por ele (ver topo do arquivo).
  agentId   String
  agent     Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title     String
  content   String
  status    String           @default("pending") // pending | ready | failed | no_embeddings
  // Arquivo original enviado pelo cliente, guardado na BunnyCDN (ver
  // src/lib/bunny.ts). `content` continua sendo o texto extraído — o
  // arquivo em si só existia em memória até aqui e nunca era persistido.
  fileUrl   String?
  fileName  String?
  chunks    KnowledgeChunk[]
  createdAt DateTime         @default(now())

  @@index([tenantId])
  @@index([agentId])
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  tenantId   String
  // Desnormalizado do documento para o RAG filtrar por agente direto no SQL
  // cru do pgvector, sem join (ver searchSimilarChunks).
  agentId    String
  documentId String
  document   KnowledgeDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  // embedding via pgvector (text-embedding-3-small = 1536 dims).
  // Unsupported: gravado/consultado via $queryRaw (ver módulo knowledge-base).
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  @@index([documentId])
  @@index([tenantId])
  @@index([agentId])
}

/// Ação habilitada para um agente. O nome segue `TenantAction` por compat, mas
/// o escopo agora é o agente: cada um liga as suas dentro do teto do plano.
model TenantAction {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId  String
  agent    Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  key      String // schedule_meeting | mark_hot_lead | register_lead | follow_up | handoff_human
  enabled  Boolean @default(false)
  config   Json?

  @@unique([agentId, key])
  @@index([tenantId])
  @@index([agentId])
}

/// Conexão de WhatsApp da conta. Uma linha por provedor: a Evolution (QR code) e
/// a API oficial da Meta podem ficar conectadas ao mesmo tempo, cada uma com o
/// seu número. Antes era uma linha só por conta e a troca de provedor
/// sobrescrevia a anterior.
model WhatsappInstance {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status     String  @default("disconnected") // disconnected | pending_qr | connected
  /// `evolution` (padrão legado) ou `meta`. String para permitir acrescentar
  /// outro adapter sem migração de enum em produção.
  provider   String  @default("evolution")
  /// Evolution: nome da instância. Meta: Phone Number ID.
  externalId String?
  /// O agente responde (e faz follow-up) quem escreve para ESTE número.
  /// Desligado, o número só recebe: as mensagens entram em Conversas para a
  /// equipe, e a Meta fica só para Disparos. Nasce ligado, o comportamento de antes.
  agentReplies Boolean @default(true)

  /// Configuração da WhatsApp Cloud API oficial. Tokens/segredos são cifrados
  /// com AES-256-GCM; nunca guardar credencial reversível em texto claro.
  metaPhoneNumberId        String?
  metaBusinessAccountId    String?
  metaDisplayPhone         String?
  metaAccessTokenEncrypted String?
  metaAppSecretEncrypted   String?
  metaVerifyTokenEncrypted String?
  // Coexistência: solicitações únicas de sincronização, sem conteúdo de conversas.
  metaCoexistenceSync Json?

  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([provider, externalId])
}

/// Queda comprovada de uma conexão do WhatsApp, aberta e fechada pelo monitor
/// de saúde (`modules/whatsapp/incidents.ts`). Base da "disponibilidade do
/// agente" no relatório mensal. Só o que o provedor confirmou: silêncio
/// suspeito não vira incidente. `endedAt` null = ainda fora do ar.
model WhatsappIncident {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider  String // evolution | meta
  kind      String // desconectado | sumiu
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, startedAt])
  @@index([tenantId, provider, endedAt])
}

model Lead {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String?
  phone     String
  status    String   @default("new") // new | warm | hot | scheduled | lost
  /// Contato criado pelo chat de teste (sandbox), não por um cliente real.
  /// Fica no banco com histórico permanente (aparece em Conversas, na aba
  /// "Testes"), mas contagem de negócio (contatos, relatórios, home) filtra
  /// `isTest: false` — antes o sandbox inflava o número de leads da conta.
  isTest    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  /// Quando o agente concluiu que este contato não é cliente em potencial
  /// (tool `disqualify_lead`). Distinto de `status: "lost"`, que é "era
  /// cliente e não fechou" — aqui nunca foi. É o que sustenta a métrica de
  /// triagem em /relatorios: sem este carimbo o número seria chute.
  /// null = nunca desqualificado.
  disqualifiedAt     DateTime?
  /// Motivo da desqualificação, do conjunto fechado de `DISQUALIFY_REASONS`
  /// (`src/modules/agent-engine/disqualify.ts`). String e não enum porque o
  /// conjunto ainda deve crescer com o que aparecer no campo, e um enum no
  /// Postgres exige migration para cada valor novo.
  disqualifiedReason String?

  conversation Conversation?
  appointments Appointment[]

  @@index([tenantId, updatedAt, id])
  @@index([tenantId])
  @@index([tenantId, isTest])
  /// Suporta a contagem por período da triagem (relatórios) sem varrer a tabela.
  @@index([tenantId, disqualifiedAt])
}

model Conversation {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Qual agente atendeu. `SetNull` (e não Cascade): excluir um agente não pode
  // apagar o histórico de conversas nem os leads que ele gerou.
  agentId         String?
  agent           Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  leadId          String    @unique
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages        Message[]
  needsHuman      Boolean   @default(false)
  /// Verdadeiro depois que um humano responde manualmente pelo painel
  /// (`sendManualMessage`). Enquanto ligado, `runAgentTurn` não gera resposta
  /// automática NESTA conversa — as outras do mesmo agente continuam normais.
  /// `needsHuman` sozinho não bastava: é só sinalizador de fila, nada no motor
  /// olhava pra ele antes de responder.
  agentPaused     Boolean   @default(false)
  /// Espelha `Lead.isTest` para as consultas de conversa não precisarem de join.
  isTest          Boolean   @default(false)
  lastInboundAt   DateTime?
  /// Por qual conexão o contato falou por último: `evolution` (QR code) ou
  /// `meta` (API oficial). Com as duas conectadas, é o que decide de qual número
  /// saem a resposta manual, o follow-up e o lembrete — o contato só conhece o
  /// número em que escreveu, e um primeiro contato pelo outro leva ao bloqueio
  /// (QR) ou à recusa da Meta (fora da janela). Null = conversa anterior a esta
  /// coluna, do site ou de teste. Ver `modules/whatsapp/instances.ts`.
  whatsappProvider String?
  /// Última mensagem de follow-up enviada, de qualquer etapa. Relatório e
  /// painel leem como "recebeu follow-up"; o worker usa como ponto de partida
  /// da etapa seguinte.
  followUpSentAt  DateTime?
  /// Quantas etapas da esteira atual já saíram. Só vale enquanto o contato não
  /// escreveu depois do último envio (`followUpSentAt >= lastInboundAt`): a
  /// resposta encerra a esteira sem ninguém precisar zerar a coluna, e o
  /// próximo silêncio começa da etapa 1. Ver workers/follow-up-worker/scan.ts.
  followUpStep    Int       @default(0)
  /// Como o contato deixou a conversa, registrado pelo agente (tool
  /// `follow_up`): null = só parou de responder (esteira "sem resposta"),
  /// "declined" = não quer agendar agora (esteira espaçada), "stop" = sem
  /// interesse / pediu para parar (nenhum follow-up). Persiste entre mensagens
  /// de propósito: o "obrigado" depois de "vou pensar" não pode devolver o
  /// contato à esteira de 30 minutos.
  followUpReason  String?
  /// Resumo em texto do que foi conversado, gerado sob demanda pelo LLM ativo
  /// (`summarizeConversation`). Existe para o dono da conta entender uma
  /// conversa de 60 mensagens sem ler tudo. Null = nunca resumida.
  summary         String?
  /// Quando o resumo foi gerado — mostrado na interface como "resumido há X".
  summaryAt       DateTime?
  /// Quantas mensagens a conversa tinha quando o resumo foi gerado. É o que
  /// permite dizer "desatualizado, N mensagens novas" sem regerar nada: basta
  /// comparar com a contagem atual. Sem isso, o resumo em cache mentiria em
  /// silêncio conforme a conversa continuasse.
  summaryMsgCount Int?
  /// Valores por conversa: { chave: valor }. Ausência = não informado.
  variables       Json?
  updatedAt       DateTime  @updatedAt

  appointments Appointment[]
  reportEvents ReportEvent[]
  knowledgeGapOccurrences KnowledgeGapOccurrence[]
  insight      ConversationInsight?

  @@index([tenantId])
  @@index([agentId])
  @@index([tenantId, isTest])
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role              String // user | assistant | system
  content           String
  /// Quem gerou uma mensagem "assistant": "agent" (a IA respondeu sozinha) ou
  /// "human" (o dono da conta respondeu manualmente pelo painel). Null em
  /// mensagens "user"/"system", onde a distinção não existe. Sem isto, uma
  /// resposta manual gravada como "assistant" faria a IA achar que foi ELA
  /// quem disse aquilo nos próximos turnos — `sentBy` deixa `role` intacto
  /// (o histórico que vai pro LLM continua "assistant", que é o que importa
  /// pro contexto) e só a UI e a auditoria usam este campo pra diferenciar.
  sentBy            String?
  /// id da mensagem no WhatsApp (key.id da Evolution). Só mensagens enviadas
  /// ou recebidas pelo WhatsApp têm. Serve para **deduplicar o webhook**: a
  /// Evolution reentrega o que a própria instância enviou (ex.: resposta do
  /// agente) como `messages.upsert` com `fromMe: true`, e sem esse id cada
  /// resposta sairia gravada duas vezes — uma pelo orquestrador, outra pelo
  /// webhook. Null em mensagens de sandbox e nas manuais antes deste campo.
  whatsappMessageId String?      @unique
  /// Áudio desta mensagem na CDN, quando ela foi enviada ou recebida como voz.
  /// Null = mensagem de texto comum (a esmagadora maioria).
  ///
  /// `content` continua sendo o TEXTO da mensagem mesmo quando há áudio — o que
  /// foi ditado (áudio gravado à mão, transcrito) ou o que foi falado (texto
  /// que virou voz). É `content` que vai para o contexto do LLM, para o resumo
  /// da conversa e para a busca; `audioUrl` é só a forma de entrega, e existe
  /// para a pessoa reouvir no painel o que de fato chegou no WhatsApp do
  /// cliente. Guardar só o áudio deixaria o histórico cego para tudo isso.
  audioUrl          String?
  /// Duração, em segundos inteiros, do áudio que chegou pelo webhook do
  /// WhatsApp (do contato ou do atendente pelo celular). A Evolution informa no
  /// payload; a Meta não, e a duração é lida do próprio arquivo OGG. É a base do
  /// "tempo de áudio economizado" do ROI mensal. Null = não medido: texto,
  /// formato que não sabemos ler, ou áudio anterior a esta coluna — nunca zero.
  audioSeconds      Int?
  createdAt         DateTime     @default(now())

  @@index([conversationId])
}

/// Um horário marcado com um lead. Nasce de duas formas: o agente usando a
/// ação `schedule_meeting` durante a conversa, ou o usuário marcando à mão em
/// /agenda. Antes `schedule_meeting` era um mock que só trocava o status do
/// lead para "scheduled" — a data combinada não era guardada em lugar nenhum.
model Appointment {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// `SetNull` como em Conversation: apagar o agente não apaga a agenda.
  agentId        String?
  agent          Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  title                  String
  /// Pessoa atendida; o contato do WhatsApp pode marcar para outra pessoa.
  patientName            String?
  notes                  String?
  startsAt               DateTime
  endsAt                 DateTime
  /// Só o ciclo de vida: de pé ou cancelada. Confirmação, remarcação e
  /// comparecimento são dimensões próprias (abaixo) — misturá-las aqui fazia
  /// "concluído" valer como "compareceu". `done` é legado: linhas antigas até
  /// `scripts/separa-dimensoes-agendamento.ts` rodar (ver `dimensions.ts`).
  status                 String    @default("scheduled") // scheduled | canceled (legado: done)
  source                 String    @default("agent") // agent | manual (humano)
  /// Duração/categoria escolhida (nome da lista do agente ou da clínica).
  serviceType            String?
  /// Tipo da consulta: evaluation | return | procedure. Null = não classificado.
  /// Só vem de escolha explícita (tela, tool com `categoria`), nunca deduzido
  /// do nome do serviço, das notas ou da conversa.
  kind                   String?
  /// Procedimento de interesse (implante, clareamento), como o contato ou a
  /// clínica informou. Independente do tipo: avaliação PARA implante.
  procedure              String?
  /// Confirmação da presença futura. Não é comparecimento: confirmar nunca
  /// muda `attendance`. Remarcar limpa (a confirmação era do horário antigo).
  confirmedAt            DateTime?
  confirmationSource     String? // human | integration
  /// Última remarcação. Null = nunca remarcada.
  rescheduledAt          DateTime?
  /// unknown (não verificado) | attended | no_show. Nasce `unknown` e só muda
  /// por marcação humana depois do horário (ou status mapeado do Clinicorp):
  /// agendar ou confirmar NUNCA vira "compareceu".
  attendance             String    @default("unknown")
  attendanceSource       String? // human | integration
  attendanceAt           DateTime?
  /// Id do evento espelhado no Google Agenda, quando a conta está integrada.
  /// Null = só existe aqui (integração desligada ou sincronização falhou).
  googleEventId          String?
  /// Id do agendamento espelhado no Clinicorp, mesma ideia do `googleEventId`.
  /// Guardado como String porque o id de lá é um inteiro de 64 bits (ex.:
  /// 4791226171916288) — fora do alcance seguro do Number do JS.
  clinicorpAppointmentId String?
  clinicorpSync          ClinicorpAppointmentSync?
  /// Antecedências (em minutos) dos lembretes que JÁ foram enviados para esta
  /// consulta. Fica aqui, e não em `Conversation` como `followUpSentAt`,
  /// porque é lembrete POR CONSULTA: o mesmo paciente marca de novo no mês
  /// seguinte e precisa ser lembrado outra vez.
  ///
  /// É uma lista, e não um booleano, porque uma consulta tem vários disparos
  /// ("1 semana antes", "1 dia antes", "2 horas antes") e cada um precisa ser
  /// marcado sozinho — senão o primeiro calaria todos os outros.
  remindersSent          Int[]     @default([])
  /// Quando o último lembrete saiu. Só para a tela ("lembrete enviado há 2h");
  /// quem decide o que ainda falta enviar é `remindersSent`.
  reminderSentAt         DateTime?
  /// Lembretes só desta consulta, sobrescrevendo os do agente. Null = usa os
  /// do agente (o caso comum). Lista vazia = esta consulta não recebe nenhum,
  /// que é diferente de "não configurado" — daí ser Json e não uma relação.
  reminderOverride       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startsAt])
  @@index([tenantId, updatedAt, id])
  @@index([leadId])
  @@index([agentId])
  /// Varredura do worker de lembrete: consultas marcadas, pelo começo. Quais
  /// disparos ainda faltam é decidido em memória (`remindersSent` é uma
  /// lista, que um índice não ajudaria a filtrar).
  @@index([status, startsAt])
}

/// Envio durável ao Clinicorp. A consulta é preservada durante falhas externas;
/// cada nova tentativa relê a agenda antes de criar para evitar duplicação.
model ClinicorpAppointmentSync {
  id             String      @id @default(cuid())
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tenantId       String
  payload        Json
  target         Json
  state          String      @default("queued") // queued | processing | retry | synced | canceled | conflict
  attempts       Int         @default(0)
  nextAttemptAt  DateTime    @default(now())
  lockedUntil    DateTime?
  lockToken      String?
  lastError      String?
  externalId     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([state, nextAttemptAt])
  @@index([tenantId])
}

/// Quais integrações de calendário a conta habilitou em /integracoes.
///
/// Separado das linhas de conexão (`CalendarIntegration`, `ClinicorpIntegration`)
/// de propósito: habilitar é a decisão "quero usar isso", tomada antes de ter
/// credencial nenhuma, e desabilitar não pode apagar o que já foi configurado —
/// quem desliga por uma semana espera reencontrar tudo ao religar.
///
/// Sem linha = nada habilitado (o padrão de toda conta nova).
model CalendarFeatures {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Mostra o card do Google Agenda na /agenda.
  googleEnabled    Boolean @default(false)
  /// Mostra o card do Clinicorp na /agenda.
  clinicorpEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Conexão OAuth da conta com o Google Agenda (opcional). Uma por tenant.
/// Os tokens ficam aqui e não em env: são credenciais DO CLIENTE, emitidas no
/// consentimento dele, e cada conta tem as suas.
model CalendarIntegration {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider     String   @default("google")
  /// Conta Google conectada — mostrada na tela para a pessoa saber qual é.
  accountEmail String?
  calendarId   String   @default("primary")
  accessToken  String
  /// Só vem no primeiro consentimento; sem ele a conexão morre em 1h.
  refreshToken String?
  expiresAt    DateTime
  /// Espelhar novos agendamentos no Google pode ser desligado sem desconectar.
  syncEnabled  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Lembretes já enviados para uma consulta marcada **direto no Clinicorp** —
/// a que não é um `Appointment` nosso (ver `listClinicorpAgenda`). Mesma ideia
/// de `Appointment.remindersSent`, mas numa tabela própria porque a consulta
/// não existe aqui: a linha só nasce quando um disparo sai ou é fechado.
///
/// `startsAt` é o horário da consulta quando o disparo foi registrado. Se a
/// recepção remarca no Clinicorp (mesmo id, outro horário), os disparos voltam
/// a valer: o "1 dia antes" da data antiga não pode calar o da nova.
/// Quem envia: `workers/follow-up-worker/clinicorp-reminders.ts`.
model ClinicorpReminder {
  id                     String    @id @default(cuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Id do agendamento no Clinicorp (inteiro de 64 bits, guardado como String).
  clinicorpAppointmentId String
  startsAt               DateTime
  /// Antecedências (minutos) já enviadas ou fechadas sem envio.
  remindersSent          Int[]     @default([])
  /// Só quando uma mensagem de fato saiu — a /agenda mostra a partir dele.
  reminderSentAt         DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([tenantId, clinicorpAppointmentId])
}

/// Conexão da conta com o Clinicorp (software de gestão de clínicas). Uma por
/// tenant, como a do Google — e pelo mesmo motivo: as credenciais são DO
/// CLIENTE (cada clínica gera as suas em Gerenciar Assinatura › Acesso Externo
/// e Integrações), não da plataforma.
///
/// Não há OAuth aqui: a API do Clinicorp usa HTTP Basic com um par fixo
/// usuário/token. Por isso a pessoa cola as credenciais na tela em vez de
/// passar por um consentimento.
model ClinicorpIntegration {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// "Usuário API" e "Token API" da tela do Clinicorp — viram o par Basic.
  apiUser      String
  apiToken     String
  /// Identificador do assinante. Obrigatório em boa parte dos endpoints e, em
  /// conta de grupo/franquia, é o que diz de qual unidade se está falando.
  subscriberId String

  /// Clínica onde os horários são criados (`Clinic_BusinessId`). A conta pode
  /// ter mais de uma; a escolhida aqui é a que recebe os agendamentos.
  businessId          String?
  /// Profissional padrão (`Dentist_PersonId`). Opcional: sem ele o agendamento
  /// entra na agenda da clínica sem profissional definido.
  dentistId           String?
  /// Categoria do agendamento criado pelo agente, pelo nome cadastrado lá
  /// (ex.: "Avaliação"). Define a cor que a clínica vê na agenda.
  categoryDescription String?

  /// Espelhar novos agendamentos pode ser desligado sem apagar as credenciais.
  syncEnabled       Boolean @default(true)
  /// Consultar a agenda do Clinicorp antes de oferecer horário. Separado do
  /// espelhamento: uma clínica pode querer só enviar, sem a leitura extra.
  checkAvailability Boolean @default(true)

  /// Diagnóstico da última chamada — a tela mostra para a pessoa saber que a
  /// credencial venceu sem precisar abrir o log do servidor.
  lastSyncAt  DateTime?
  lastErrorAt DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Configuração de IA da PLATAFORMA (não é por tenant) — linha única.
/// Trocada pelo superadmin em /admin/ia; lida por src/modules/ai/settings.ts.
model AiSetting {
  id              String   @id @default("singleton")
  modelId         String // id do modelo no catálogo (src/modules/ai/catalog.ts)
  /// Minutos que uma credencial fica em quarentena depois de estourar cota.
  /// Configurável porque a janela certa depende do provedor: free tier do
  /// Gemini renova por minuto, cota diária de outro provedor só no dia
  /// seguinte. 0 desliga a quarentena (tenta sempre a ordem inteira).
  cooldownMinutes Int      @default(5)
  updatedAt       DateTime @updatedAt
  updatedBy       String? // e-mail do superadmin que trocou
}

/// Um degrau da cadeia de fallback da IA, na ordem em que o agente tenta.
///
/// Antes a cadeia era fixa no código (Gemini free → Grok → Groq, em
/// `catalog.ts`): mudar a ordem ou acrescentar um provedor exigia deploy. Cada
/// linha aqui é "tente este modelo com esta credencial"; `position` dá a ordem
/// e `enabled` permite desligar um degrau sem perder a configuração dele.
///
/// A cadeia do código continua valendo como padrão enquanto não houver
/// nenhuma linha — conta nova não fica sem fallback por omissão.
model AiFallbackStep {
  id       String  @id @default(cuid())
  /// Id do modelo no catálogo (src/modules/ai/catalog.ts).
  modelId  String
  /// Ordem de tentativa, do menor para o maior. O primeiro é o modelo que
  /// atende normalmente; os seguintes só entram quando o anterior falha.
  position Int
  enabled  Boolean @default(true)

  /// Credencial a usar neste degrau. Nulo = a chave do `.env` do provedor,
  /// que continua sendo o padrão de quem nunca mexeu no painel.
  credentialId String?
  credential   AiCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([position])
  @@index([credentialId])
}

/// Chave de API de um provedor de IA, cadastrada pelo admin sem deploy.
///
/// O segredo é CIFRADO (AES-256-GCM, `src/lib/crypto.ts`, chave em
/// `ENCRYPTION_KEY`) — mesma decisão do `ClinicorpIntegration`: é credencial
/// que precisa voltar em texto claro para montar o header da chamada, o
/// oposto de senha de usuário (hash, nunca lida de volta). Nunca leia
/// `secretEncrypted` direto do Prisma; passe por `src/modules/ai/credentials.ts`.
///
/// Permite mais de uma chave por provedor: esgotada a cota da primeira, a
/// próxima assume — é o que faz "quantas chaves quiser" funcionar.
model AiCredential {
  id              String  @id @default(cuid())
  /// "gemini" | "openai" | "grok" | "groq" para os embutidos, ou "custom" para
  /// um provedor cadastrado pelo admin (ver `baseUrl`/`modelId`).
  provider        String
  /// URL base da API — só para `provider: "custom"`. Qualquer serviço que
  /// exponha /chat/completions no formato da OpenAI serve (DeepSeek, Together,
  /// OpenRouter, Mistral, Ollama, vLLM…): esse formato virou padrão de fato,
  /// e por isso um adapter só cobre todos eles sem precisar de deploy.
  baseUrl         String?
  /// Nome do modelo nesse provedor ("deepseek-chat"). Digitado, não escolhido
  /// de uma lista: só o próprio serviço sabe o que oferece.
  modelId         String?
  /// Nome que o admin reconhece na lista ("Groq conta 2").
  label           String
  /// Chave cifrada. Nunca sai daqui em texto claro para o cliente.
  secretEncrypted String
  /// Últimos 4 caracteres, em claro, só para o admin identificar qual é qual
  /// sem revelar a chave.
  lastFour        String

  /// Até quando esta credencial está em quarentena por ter estourado cota.
  /// Nulo = disponível. Ver `cooldownMinutes` em `AiSetting`.
  cooldownUntil DateTime?
  /// Motivo da última falha — ajuda o admin a distinguir "cota" de "chave
  /// inválida", que pedem reações diferentes.
  lastError     String?
  lastUsedAt    DateTime?

  steps AiFallbackStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // e-mail do superadmin que cadastrou

  @@index([provider])
}

/// Uso de tokens por provedor de IA da PLATAFORMA, agregado por dia. Um
/// contador incrementado a cada resposta bem-sucedida (não uma linha por
/// chamada) — o que /admin/ia mostra como "% de uso" vem daqui, quando o
/// provedor expõe um teto (só o Groq hoje, via headers de rate-limit lidos em
/// tempo real — não guardados aqui). Sem histórico anterior à instrumentação:
/// mensagens geradas antes disso não têm como ser atribuídas a um provedor
/// (ver src/modules/ai/usage.ts para a estimativa retroativa aproximada).
model AiUsageDaily {
  id               String   @id @default(cuid())
  /// "gemini" | "openai" | "grok" | "groq" — chave do provedor (não do modelo:
  /// vários modelos do catálogo dividem a mesma chave de API/provedor).
  provider         String
  /// Meia-noite UTC do dia — chave de agrupamento, não instante de evento.
  day              DateTime
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  /// Quantas chamadas bem-sucedidas compõem este total — não é o mesmo que
  /// turnos do agente (uma iteração de tool-calling pode chamar o LLM 2+ vezes).
  requests         Int      @default(0)

  @@unique([provider, day])
}

/// Quanto um lead fechado vale para o dono — definido manualmente na visão
/// Financeira de /relatorios. Cada alteração cria uma entrada nova com vigência
/// (`startsAt`): períodos já iniciados usam o valor em vigor no início deles,
/// então mudar o valor não recalcula relatórios passados retroativamente.
model TenantLeadValue {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Em centavos de real (mesma unidade de `Plan.priceCents`).
  valueCents Int
  /// Entra em vigor a partir desta data/hora.
  startsAt   DateTime
  createdAt  DateTime @default(now())

  @@index([tenantId, startsAt])
}

/// Quanto custa à clínica atender um contato à mão — a base da métrica de
/// triagem ("o que o agente evitou") na visão Financeira de /relatorios.
///
/// Segue o mesmo contrato de `TenantLeadValue` (e existe separado dele porque
/// responde outra pergunta: o valor do lead é receita, isto é custo): cada
/// alteração cria uma entrada com vigência, e períodos já iniciados mantêm o
/// valor em vigor no início deles.
///
/// Os dois campos juntos são o que permite converter triagem em dinheiro:
/// `minutesPerLead` × `hourlyCostCents / 60`. Enquanto não houver nenhuma
/// entrada, o relatório mostra estado vazio com a chamada para definir —
/// nunca um número médio inventado, que o cliente conferiria e não bateria.
model TenantAttendanceCost {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Minutos que um atendente humano gastaria com um contato (triagem + resposta).
  minutesPerLead  Int
  /// Custo da hora do atendente, em centavos (mesma unidade de `Plan.priceCents`).
  hourlyCostCents Int
  /// Entra em vigor a partir desta data/hora.
  startsAt        DateTime
  createdAt       DateTime @default(now())

  @@index([tenantId, startsAt])
}

/// Token de "esqueci minha senha". Guardamos só o SHA-256 do token — o valor
/// que vai no link do e-mail nunca toca o banco, então um dump vazado não
/// permite redefinir a senha de ninguém.
///
/// Uso único e com validade curta (`PASSWORD_RESET_TTL_MINUTES`): pedir um novo
/// link invalida os anteriores, e usar um invalida todos os que sobraram.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  /// Quem pediu — para investigar um pedido que o dono da conta não reconhece.
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Trilha de auditoria das tentativas de login (credenciais e Google).
///
/// O bloqueio em si NÃO sai daqui — ele vive no Redis (`lib/login-throttle`),
/// que é rápido e expira sozinho. Esta tabela existe para a pergunta que o
/// Redis não responde depois do fato: "quem tentou entrar nessa conta na
/// terça?". Escrita best-effort: falha aqui nunca derruba o login.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  /// Null quando o payload nem tinha e-mail válido.
  email     String?
  success   Boolean  @default(false)
  /// credentials | google
  provider  String   @default("credentials")
  /// Por que falhou (bad_password, no_account, blocked…) — null em sucesso.
  reason    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

/// IP barrado do login **por decisão do admin**.
///
/// Não confundir com o freio de força bruta (`lib/login-throttle`): aquele é
/// automático, mora no Redis, conta e-mail+IP e expira sozinho em minutos. Este
/// é deliberado, dura o que o admin quiser e precisa sobreviver a um `FLUSHALL`
/// e a um restart do Redis — por isso Postgres, e não cache. São mecanismos
/// distintos de propósito: um contém ataque em curso sozinho, o outro é uma
/// decisão humana com autor e motivo registrados.
///
/// Barra só a **autenticação** (credenciais e Google), não o site inteiro. O
/// alcance é estreito de propósito: bloquear no middleware custaria uma checagem
/// em toda requisição e arriscaria derrubar webhook de terceiro que
/// compartilhasse o IP — o problema real é sempre alguém tentando ENTRAR.
model BlockedIp {
  id String @id @default(cuid())

  /// O endereço, exatamente como `requestContext()` o resolve (primeiro item
  /// do `x-forwarded-for`). `@unique` porque bloquear duas vezes o mesmo IP não
  /// é dois bloqueios — a segunda vez atualiza a primeira.
  ip String @unique

  /// Por que foi bloqueado. Obrigatório: um bloqueio sem motivo é impossível de
  /// revisar depois, e quem encontra a linha meses adiante não tem como decidir
  /// se ainda faz sentido.
  reason String

  /// Quem bloqueou. Guardado por cópia (não por relação) para sobreviver à
  /// exclusão da conta do admin — o mesmo motivo do `actorEmail` no AuditLog.
  blockedById    String?
  blockedByEmail String?

  /// Quando deixa de valer. `null` = até alguém desbloquear à mão.
  /// A expiração é verificada na LEITURA, não por um job: um bloqueio vencido
  /// que continua na tabela não barra ninguém, e varrer a tabela de tempos em
  /// tempos só para apagar linhas seria trabalho sem ganho.
  expiresAt DateTime?

  /// Contexto do momento do bloqueio, para a lista não virar uma coluna de
  /// números soltos: último e-mail tentado desse IP e quantas tentativas ele
  /// tinha. Congelados — descrevem o que o admin viu ao decidir.
  lastEmail       String?
  attemptsAtBlock Int     @default(0)

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Trilha de auditoria (o que aconteceu na plataforma)
//
// `LoginAttempt` (acima) responde "quem tentou entrar"; `AuditLog` responde
// "quem mudou o quê". São tabelas separadas de propósito: a de login é escrita
// no caminho anônimo (quem falha o login não tem sessão, nem tenant) e tem
// volume e retenção próprios — juntar as duas obrigaria metade das colunas a
// ser nula em metade das linhas.
//
// A ideia central: o log guarda o **estado**, não só o nome do evento. Cada
// linha carrega `before` e `after` — os campos que mudaram, antes e depois.
// Isso é o que torna "reverter" possível sem uma função de undo escrita à mão
// para cada ação: desfazer é regravar `before` na linha que `targetId` aponta.
// Um log que só dissesse "fulano alterou o agente" registraria a ocorrência e
// perderia justamente a informação que permite desfazê-la.
//
// Exclusão usa o mesmo mecanismo, ao contrário: `before` é a linha inteira e
// `after` é null; restaurar recria o registro com o MESMO id (ver
// `modules/audit/revert.ts`), para que o que apontava para ele volte a apontar.
// ─────────────────────────────────────────────────────────────────────────────

/// Um evento registrado da plataforma. Escrita best-effort, como a de login:
/// falhar ao auditar nunca pode derrubar a ação que estava sendo auditada.
model AuditLog {
  id String @id @default(cuid())

  /// Conta afetada. Null em evento sem tenant (login que falhou, por exemplo)
  /// e nas linhas cuja conta já foi excluída — `SetNull`, não `Cascade`: o
  /// registro de uma exclusão não pode sumir junto com o que foi excluído,
  /// senão a trilha apaga justamente o evento mais grave que ela guarda.
  tenantId   String?
  tenant     Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  /// Nome da conta no momento do evento. Redundante de propósito: sobrevive à
  /// exclusão do tenant, quando `tenantId` vira null e o join não devolve nada.
  tenantName String?

  /// Quem fez. Também `SetNull` + cópia do e-mail, pela mesma razão.
  actorId      String?
  actorEmail   String?
  /// OWNER | SUPERADMIN | SYSTEM — papel de quem agiu, congelado na linha.
  /// "SYSTEM" é o que a plataforma faz sozinha (webhook, worker, cron).
  actorRole    String  @default("OWNER")
  /// O admin agiu personificando o cliente (ver lib/impersonation). Sem isto a
  /// trilha mostraria o dono da conta fazendo o que o suporte fez por ele.
  impersonated Boolean @default(false)

  /// Evento em `dominio.acao` (ver AUDIT_EVENTS em modules/audit/events.ts).
  /// String, não enum do banco: evento novo não deve exigir migração, e a
  /// tabela guarda histórico — um enum antigo travaria linhas já gravadas.
  event String
  /// create | update | delete | auth | access — para filtrar e para decidir
  /// como reverter (update regrava `before`; delete recria a linha).
  kind  String

  /// O que foi afetado: modelo do Prisma (`Agent`, `Tenant`, `Lead`…) e id.
  /// Sem `@relation` — a linha aponta para tabelas diferentes conforme o
  /// evento, e o alvo pode nem existir mais.
  targetType  String?
  targetId    String?
  /// Rótulo legível do alvo no momento do evento ("Agente de vendas"). A tela
  /// mostra isto; sem ele, um log de exclusão viraria um cuid sem sentido.
  targetLabel String?

  /// Estado ANTES e DEPOIS, só com os campos que a ação toca (ver
  /// `diffFields`). Objetos JSON planos: `{ "enabled": true }`.
  /// - update: os dois preenchidos.
  /// - create: `before` null.
  /// - delete: `after` null e `before` com a linha inteira, para restaurar.
  before Json?
  after  Json?

  /// Contexto extra que não é estado do registro (motivo, quantidades, ip de
  /// origem de um webhook). Nunca usado para reverter.
  meta Json?

  ip        String?
  userAgent String?

  /// Este evento pode ser desfeito pelo admin. Falso para o que é irreversível
  /// por natureza (login, acesso, exclusão de conta) — a tela não oferece o
  /// botão e `revertAuditLog` recusa de novo no servidor.
  revertible Boolean @default(false)

  /// Quando alguém desfez este evento. Preenchido = já revertido, e a trilha
  /// não deixa reverter duas vezes (a segunda regravaria um `before` que já
  /// não corresponde ao estado atual).
  revertedAt      DateTime?
  revertedById    String?
  revertedByEmail String?
  /// Log gerado PELA reversão. Desfazer é uma ação como outra qualquer e vira
  /// linha nova — a trilha nunca é editada para esconder o que aconteceu.
  revertLogId     String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([event, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Programa de afiliados
//
// Um afiliado é um PAPEL do usuário, não uma conta separada: a mesma pessoa
// pode ser cliente do fechai, afiliado, ou os dois (escolhido no /cadastro e
// ativável depois). Por isso o vínculo é 1:1 com User — quem já tem conta vira
// afiliado sem criar outro login.
//
// Comissão é RECORRENTE (o produto é SaaS): o afiliado ganha um % de cada
// pagamento mensal enquanto a assinatura indicada continuar viva. Cada
// pagamento vira uma linha em AffiliateCommission — nunca se recalcula o
// passado a partir do percentual atual, senão mudar a regra reescreveria o
// histórico de quem já ganhou.
// ─────────────────────────────────────────────────────────────────────────────

enum AffiliateStatus {
  PENDING // cadastrou-se, aguardando aprovação do admin
  ACTIVE // pode divulgar e receber comissão
  SUSPENDED // bloqueado pelo admin; links param de converter (comissões antigas permanecem)
  OPTED_OUT // a própria pessoa saiu do programa em /configuracoes — pode voltar quando quiser
}

enum ReferralStatus {
  CLICK // clicou no link, ainda não criou conta
  SIGNED_UP // criou conta pelo link, ainda não pagou
  CONVERTED // assinou um plano pago — gera comissão recorrente
  CHURNED // cancelou a assinatura; para de gerar comissão nova
}

enum CommissionStatus {
  PENDING // dentro da janela de segurança (estorno/chargeback)
  APPROVED // liberada para saque
  PAID // já paga ao afiliado
  CANCELED // estornada (reembolso/chargeback do pagamento de origem)
}

model Affiliate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Código público que vive na URL (?ref=CODIGO). Curto, legível e único —
  /// é o que o afiliado divulga, então precisa caber num story e num print.
  code   String          @unique @default(cuid())
  status AffiliateStatus @default(ACTIVE)

  /// Percentual de comissão em BASIS POINTS (2000 = 20%). Inteiro de propósito:
  /// float em dinheiro acumula erro, e bps evita o "20.000000000000004".
  /// Null = usa o padrão do programa (ver modules/affiliates/config.ts).
  commissionBps Int?

  /// Dados de pagamento (PIX) — o afiliado é pago fora do Stripe, por
  /// transferência manual no MVP.
  payoutPixKey String?
  payoutName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals   Referral[]
  commissions AffiliateCommission[]

  @@index([status])
}

/// Um lead do afiliado: nasce no clique e evolui até virar assinatura paga.
/// `tenantId` é único porque um tenant só pode ser creditado a um afiliado —
/// o primeiro que trouxe (first-touch), para não haver disputa de crédito.
model Referral {
  id          String         @id @default(cuid())
  affiliateId String
  affiliate   Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  status      ReferralStatus @default(CLICK)

  /// Conta criada a partir do link. Null enquanto for só clique.
  tenantId String? @unique
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  /// Plano divulgado no link que originou o clique (?plano=PRO) — serve para
  /// o afiliado ver qual oferta converte melhor, não para forçar o plano.
  planKeyHint PlanKey?

  /// Origem do clique, para o afiliado medir onde divulgar.
  landingPath String?
  utmSource   String?

  clickedAt   DateTime  @default(now())
  signedUpAt  DateTime?
  convertedAt DateTime?
  churnedAt   DateTime?

  commissions AffiliateCommission[]

  @@index([affiliateId, status])
  @@index([clickedAt])
}

/// Uma parcela de comissão = um pagamento mensal da assinatura indicada.
/// `stripeEventId` é único: o webhook do Stripe reentrega eventos, e sem essa
/// trava a mesma fatura pagaria comissão duas vezes.
model AffiliateCommission {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referralId  String
  referral    Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)

  /// Valor pago pelo cliente (centavos) e o que o afiliado ganha (centavos).
  /// Guardar os dois — mais o bps aplicado — congela a regra do dia do
  /// pagamento: mudar o percentual amanhã não reescreve o que já foi ganho.
  baseAmountCents Int
  amountCents     Int
  commissionBps   Int
  planKey         PlanKey

  status CommissionStatus @default(PENDING)

  /// Idempotência do webhook: um evento de pagamento → uma comissão.
  stripeEventId   String? @unique
  stripeInvoiceId String?

  /// Competência ("2026-08") — agrupa o extrato mensal do afiliado.
  periodMonth String

  createdAt  DateTime  @default(now())
  approvedAt DateTime?
  paidAt     DateTime?

  @@index([affiliateId, status])
  @@index([affiliateId, periodMonth])
  @@index([createdAt])
}

/// Números que o agente ignora neste WhatsApp. Uma linha por (tenant, número) —
/// tabela e não coluna Json no Tenant porque o webhook consulta isto a cada
/// mensagem que entra: com índice único dá um lookup por chave, enquanto um
/// array em Json obrigaria a carregar e varrer a lista inteira sempre.
///
/// `phone` guarda a forma CANÔNICA (só dígitos, ver `canonicalPhone()` em
/// src/modules/whatsapp/blocklist.ts): o dono digita "(11) 98765-4321" e o
/// WhatsApp entrega "5511987654321". Comparar o que foi digitado nunca casaria.
/// `label` é a anotação livre de quem bloqueou ("ex-fornecedor", "spam") — o
/// número sozinho não lembra o motivo seis meses depois.
model WhatsappBlockedNumber {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone     String
  label     String?
  createdAt DateTime @default(now())

  @@unique([tenantId, phone])
  @@index([tenantId])
}

/// Conexão independente por conta. A URL inteira é uma credencial cifrada.
model BitrixIntegration {
  tenantId          String    @id
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhook           String?
  portalHost        String
  connectionKey     String
  revision          String
  enabled           Boolean   @default(true)
  syncLeads         Boolean   @default(true)
  syncAppointments  Boolean   @default(true)
  crmMode           Int
  responsibleId     String
  connectedAt       DateTime  @default(now())
  leadCursor        DateTime  @default("1970-01-01T00:00:00.000Z")
  leadAfter         String    @default("")
  appointmentCursor DateTime  @default("1970-01-01T00:00:00.000Z")
  appointmentAfter  String    @default("")
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// Referências externas, fila e claim duráveis; nunca redirecionar um envio
/// antigo a outro portal. `uncertain` impede repetir uma criação sem resposta.
model BitrixSyncJob {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionKey  String
  kind           String // lead | appointment
  entityId       String
  payload        Json
  fingerprint    String
  state          String    @default("queued") // queued | processing | retry | synced | skipped
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lockedUntil    DateTime?
  lockToken      String?
  lastError      String?
  contactId      String?
  contactManaged Boolean   @default(false)
  crmId          String?
  crmEntityType  Int?
  activityId     String?
  uncertain      String? // contact | crm | activity (só reconciliação, sem novo POST)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, connectionKey, kind, entityId])
  @@index([tenantId, connectionKey, state, nextAttemptAt])
}

/// Intenção única compartilhada entre lembrete automático e manual.
model ReminderDispatch {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceKey String
  startsAt DateTime
  minutesBefore Int
  state String @default("queued")
  reason String?
  provider String?
  messageId String?
  conversationId String?
  token String?
  claimedAt DateTime?
  acceptedAt DateTime?
  manualBy String?
  deliveryStatus String?
  deliveryAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, sourceKey, startsAt, minutesBefore])
  @@index([tenantId, startsAt])
  @@index([tenantId, provider, messageId])
  @@index([state, claimedAt])
}

/// Recibo pode chegar antes da resposta do POST. Nunca autoriza reenvio.
model ReminderReceipt {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider String
  messageId String
  status String
  occurredAt DateTime
  createdAt DateTime @default(now())
  @@unique([tenantId, provider, messageId, status])
  @@index([createdAt])
}
