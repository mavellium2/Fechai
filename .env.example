# App / DB
# Local (fora do Docker, com `npm run db:up`): porta 5433 no host para não colidir
# com um Postgres local na 5432.
# Em docker-compose.yml: sobrescrito automaticamente para apontar pro serviço
# "postgres" da rede interna — não precisa editar pra rodar em produção.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/saas?schema=public"
# Banco exclusivo do laboratório administrativo local. Nunca use a mesma URL acima.
# Git/deploy não cria nem envia este banco; homologação online exige implantação
# e DATABASE_URL próprias.
# O script cria o banco se o usuário do Postgres tiver permissão.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/saas_test?schema=public"
# Em uma implantação separada de homologação, defina como "test" para exibir
# o aviso visual no painel. `npm run dev:test` define isto automaticamente.
DATABASE_ENVIRONMENT="production"

# Backup do banco (scripts/backup*.ts + deploy/fechai-backup.service)
# BACKUP_ON_BOOT=false  -> não dispara um dump pesado a cada restart do daemon
# BACKUP_PG_CONTAINER   -> nome do container Postgres a dumpar (obrigatório na VPS,
#                          onde há vários Postgres; descubra com `docker ps`).
#                          Ex.: BACKUP_PG_CONTAINER=fechai-postgres-1
# PGBIN                 -> opcional: caminho da pasta bin do PostgreSQL para usar
#                          pg_dump/psql local (sem isso, descobre o container pela
#                          porta do DATABASE_URL ou o binário instalado no Windows).
# BACKUP_ON_BOOT=false
# BACKUP_PG_CONTAINER=fechai-postgres-1
# PGBIN=

# SEO — domínio canônico público (SEM barra final).
# Usado em canonical, sitemap.xml, robots.txt, llms.txt, Open Graph e JSON-LD.
# É a única fonte do domínio: se ficar errado, o Google indexa a URL errada.
# Não confunda com NEXTAUTH_URL (que em dev aponta pra localhost).
NEXT_PUBLIC_SITE_URL="https://fechai.januscms.com.br"
# Host usado nas regras do Traefik para os slots blue/green.
APP_DOMAIN="fechai.januscms.com.br"

# PostHog — credenciais públicas do cliente para analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="your_posthog_project_token"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Código de verificação do Google Search Console (a meta tag "google-site-verification").
# Pegue em https://search.google.com/search-console → Adicionar propriedade → Tag HTML.
GOOGLE_SITE_VERIFICATION=""

# Auth (NextAuth / Auth.js v5)
NEXTAUTH_SECRET=""
# Em produção, use a URL pública real (SEM barra final). Ex.: https://fechai.januscms.com.br
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Stripe (test mode)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# IA — provedor ativo é escolhido em /admin/ia (persistido no banco).
# Gemini é o padrão (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Opcional — só se for usar um modelo OpenAI no catálogo.
OPENAI_API_KEY=""
# Opcional — chave da xAI. Sem ela o agente responde com Gemini; com ela, quando
# um modelo Gemini do plano gratuito falhar (cota/rate limit/erro) o agente troca
# automaticamente para Grok. Chave em: https://console.x.ai/
XAI_API_KEY=""
# Opcional — chave da Groq. Terceiro elo da chain de fallback (Gemini → Grok →
# Groq): se Grok também falhar, tenta Groq. Chave em: https://console.groq.com/keys
GROQ_API_KEY=""

# WhatsApp (Evolution API — gateway self-hosted, ver docker-compose.yml)
# AUTHENTICATION_API_KEY da instância (o "token" do gateway). Mesmo valor no
# docker-compose.evolution.yml local e no serviço "evolution" de produção.
# Em docker-compose.yml o "web"/"worker" usam http://evolution:8080 (rede interna)
# — o valor abaixo é para o desenvolvimento local.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
# Opcionais — configuração do serviço "evolution"/"evolution-postgres" no compose.
EVOLUTION_PORT=8080
EVOLUTION_PUBLIC_URL=""
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=evolution
EVOLUTION_DB_NAME=evolution
# Pool próprio da Evolution. O default calculado pelo Prisma já ficou em apenas
# 5 conexões e travou o recebimento; estes valores são aplicados pelo compose.
EVOLUTION_DB_CONNECTION_LIMIT=10
EVOLUTION_DB_POOL_TIMEOUT=30
# Para o app RECEBER mensagens reais, aponte para o webhook do fechai e ligue.
EVOLUTION_WEBHOOK_ENABLED=false
EVOLUTION_WEBHOOK_URL=""
# OBRIGATÓRIA para receber mensagens: o webhook do WhatsApp RECUSA tudo sem ela.
# Sem este segredo, quem descobrisse o id de uma instância injetava mensagem em
# qualquer conversa, disparava agendamento real e queimava a cota de LLM da conta.
# Configure o MESMO valor na Evolution, como header `x-webhook-secret` do webhook.
# Gere com:  openssl rand -base64 32
WHATSAPP_WEBHOOK_SECRET=""

# WhatsApp Cloud API oficial da Meta. As credenciais são por tenant e ficam
# cifradas no banco; aqui só fica a versão da Graph API usada nos endpoints.
# Atualize de forma deliberada depois de revisar o changelog da Meta.
META_GRAPH_API_VERSION="v26.0"
# Cadastro incorporado (coexistência): configuração do app parceiro, só no servidor.
# Guia: docs/META_COEXISTENCIA.md. Exige HTTPS e habilitação de Tech Provider na Meta.
META_APP_ID=""
META_APP_SECRET=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
# Gere um segredo aleatório com pelo menos 32 caracteres; não é access token.
# Callback do app: https://SEU-DOMINIO/api/webhooks/whatsapp/meta
META_WEBHOOK_VERIFY_TOKEN=""

# Jobs
# Local (fora do Docker): aponta pro Redis do `npm run db:up`.
# Em docker-compose.yml: sobrescrito para redis://redis:6379 (rede interna).
REDIS_URL="redis://localhost:6379"

# BunnyCDN — Storage Zone dedicada do fechai (arquivos da base de conhecimento
# dos clientes + o widget.js de cada tenant, publicado sozinho — ver
# src/lib/widget/deploy.ts). Passo a passo de criação no painel: ver README ou
# pedir pro assistente.
BUNNY_HOST="storage.bunnycdn.com"
BUNNY_STORAGE_ZONE=""
BUNNY_ACCESS_KEY=""
BUNNY_PULL_ZONE=""
# Mesmo valor de BUNNY_PULL_ZONE, mas público (embutido no HTML do snippet
# de instalação) — por isso o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_BUNNY_PULL_ZONE=""
# API Key de CONTA (painel Bunny → ícone do perfil → Account Settings → API) —
# diferente da AccessKey acima. Sem ela, uploads funcionam mas o cache de 30
# dias da pull zone não é purgado ao republicar um arquivo (ex.: widget.js).
BUNNY_API_KEY=""

# Criptografia de credenciais de terceiros guardadas no banco (Clinicorp, e o
# que vier depois). Sem ela a conta não consegue conectar esses sistemas — o
# resto do produto funciona normalmente.
# Gere com:  openssl rand -base64 32
# TROCAR ESTA CHAVE torna ilegíveis as credenciais já salvas: cada conta precisa
# reconectar. Guarde junto dos outros segredos de produção e faça backup dela.
ENCRYPTION_KEY=""

# Backups — cifra os dumps do banco (scripts/backup.ts). Sem ela o backup é
# gravado em texto claro: um único arquivo vazado entrega o banco inteiro de
# TODOS os tenants (hash de senha, CPF/CNPJ e telefone de leads, conversas,
# tokens de integração). O restore detecta o formato pelo sufixo .enc, então
# backups antigos, sem cifra, continuam restaurando normalmente.
# Gere com:  openssl rand -base64 32
# GUARDE FORA DO SERVIDOR DE BACKUP — chave e arquivo no mesmo lugar vazam juntos.
# Perder esta chave torna os backups cifrados irrecuperáveis.
BACKUP_ENCRYPTION_KEY=""

# Fish Audio (OPCIONAL) — voz do agente: o cliente grava a voz dele em /agentes
# (passo Comportamento) e o agente responde em áudio quando o contato manda
# áudio. Chave da PLATAFORMA, uma só para todas as contas (o custo é seu, como
# o dos LLMs) — o cliente não cria conta na Fish Audio.
# Pegue em: https://fish.audio/app/api-keys/
# Sem esta chave o produto funciona normalmente: a opção "Responder com áudio"
# aparece indisponível e todas as respostas saem em texto.
FISH_AUDIO_API_KEY=""

# Clinicorp (OPCIONAL) — não tem variável de ambiente: as credenciais são de
# cada clínica (Usuário API + Token API, em Gerenciar Assinatura › Acesso
# Externo e Integrações) e ficam cifradas no banco, uma por conta. Basta a
# ENCRYPTION_KEY acima estar configurada.

# Google Agenda (OPCIONAL) — só para o cliente espelhar os horários marcados
# pelo agente na agenda dele. Sem isto, a Agenda do fechai funciona normalmente,
# só não aparece o botão de conectar.
# Passo a passo: console.cloud.google.com → criar projeto → "APIs e serviços" →
# ativar "Google Calendar API" → "Tela de permissão OAuth" (tipo Externo, escopos
# .../auth/calendar.events e .../auth/userinfo.email) → "Credenciais" → criar
# "ID do cliente OAuth" do tipo "Aplicativo da Web" → em "URIs de redirecionamento
# autorizados" cole EXATAMENTE a URL abaixo:
#   http://localhost:3001/api/integrations/google/callback   (desenvolvimento)
#   https://SEU-DOMINIO/api/integrations/google/callback     (produção)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Só preencha se a URL de retorno do OAuth for diferente de NEXTAUTH_URL —
# por padrão ela é derivada dela + /api/integrations/google/callback.
GOOGLE_REDIRECT_URI=""

# Entrar com Google (OPCIONAL) — o botão na tela de /login. Ele NÃO cria conta:
# só entra em conta que já existe, porque o /cadastro exige CPF/CNPJ, telefone e
# segmento, que o Google não fornece. Sem estas chaves o botão simplesmente não
# aparece.
#
# Dá para reaproveitar o MESMO cliente OAuth do Google Agenda acima — basta
# ACRESCENTAR estas URIs de redirecionamento nele (as do Agenda continuam):
#   http://localhost:3001/api/auth/callback/google   (desenvolvimento)
#   https://SEU-DOMINIO/api/auth/callback/google     (produção)
# Nesse caso deixe as duas variáveis abaixo vazias: o login cai em
# GOOGLE_CLIENT_ID/SECRET sozinho. Preencha só se quiser um cliente OAuth
# separado para o login.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# E-mail transacional (Resend) — usado hoje pelo "Esqueci minha senha".
# Sem estas duas variáveis, em desenvolvimento o e-mail é impresso no terminal
# (dá para copiar o link e testar o fluxo inteiro); em PRODUÇÃO o pedido de
# redefinição falha com aviso na tela.
# O domínio de MAIL_FROM precisa estar verificado em resend.com/domains.
RESEND_API_KEY=""
MAIL_FROM="fechai <nao-responda@SEU-DOMINIO>"

# Worker de follow-up (workers/follow-up-worker) — opcional, valor padrão no código.
# O intervalo de silêncio (antes: FOLLOWUP_DELAY_MINUTES) agora é por agente,
# configurado em /agentes/[id] → Ações → Follow-up automático.
FOLLOWUP_SCAN_EVERY_MINUTES=15
# Lembretes consultam a agenda a cada minuto para respeitar o horário escolhido.
REMINDER_SCAN_EVERY_MINUTES=1
# Lembretes das consultas marcadas direto no Clinicorp. Cada volta relê a
# agenda de lá de cada clínica: a cada minuto seriam 1.440 chamadas por dia.
CLINICORP_REMINDER_SCAN_EVERY_MINUTES=5
# Verifica conexão + webhook separadamente, com recuperação automática rápida.
WHATSAPP_HEALTH_SCAN_EVERY_MINUTES=1
# Perguntas sem resposta (/perguntas): avisos na hora e resumo diário.
KNOWLEDGE_GAP_SCAN_EVERY_MINUTES=2
# Opcional: e-mail da Mavellium que recebe, às 8h, as contas com fila aberta
# em que ela responde. Vazio = sem esse resumo (a fila segue em /admin/perguntas).
KNOWLEDGE_GAPS_ADMIN_EMAIL=""

# --- Docker / produção (docker-compose.yml) ---
# Credenciais do container Postgres. POSTGRES_PASSWORD é obrigatório (sem default).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=""
POSTGRES_DB=saas
# Portas no host (loopback) dos serviços — usadas só pra debug via SSH no servidor
# (psql, redis-cli). Se 5433/6379 já estiverem ocupadas na VPS, troque por portas
# livres. Não afeta o tráfego externo (o app usa a rede interna do compose).
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# PDF do relatório mensal: Chromium que imprime a página (a imagem Docker já define os dois).
# Em desenvolvimento, aponte para o Chrome local; sem navegador, a rota abre a página de impressão.
# CHROMIUM_PATH=/usr/bin/google-chrome
# PDF_BASE_URL=http://127.0.0.1:3001
